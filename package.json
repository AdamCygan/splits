{
  "name": "pointhours",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project api",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "check:launch": "vitest run --project launch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "stripe:setup": "tsx scripts/stripe-setup.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "0.10.15",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-query-devtools": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.4",
    "@tanstack/react-start": "1.169.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "jose": "6.2.18",
    "lucide-react": "^0.577.0",
    "nitro": "3.0.260610-beta",
    "pg": "8.23.1",
    "posthog-js": "^1.453.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "stripe": "23.2.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tanstack/devtools-vite": "0.8.7",
    "@tanstack/eslint-config": "0.5.0",
    "@types/node": "^22.10.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "prettier": "^3.10.1",
    "tsx": "4.23.15",
    "typescript": "^6.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.16.1"
}
