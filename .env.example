# Skopiuj do .env (lokalnie) albo ustaw jako sekrety na serwerze. Plik .env NIE trafia do gita.

# --- Baza danych (Postgres: lokalny, z docker compose albo Neon) ----------------
# Neon: Dashboard → Connect. Na Fly.io wystarczy adres bez "-pooler".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/splits
# Opcjonalnie: osobny adres do migracji (Neon: bez "-pooler"), gdy aplikacja używa poolera.
# DATABASE_URL_UNPOOLED=

# --- Sesje ---------------------------------------------------------------
# Min. 32 losowe znaki. Wygeneruj:  openssl rand -base64 48
JWT_SECRET=

# --- Adres publiczny (linki w e-mailach, powrót z Google, canonical/sitemap) ---
APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000

# --- Logowanie Google (opcjonalnie) ----------------------------------------
# https://console.cloud.google.com/apis/credentials → OAuth client ID (Web application)
# Authorized redirect URI: {APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-maile (reset hasła) --------------------------------------------------
# Bez klucza e-maile trafiają do logu serwera. https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=Splits <no-reply@splits.app>

# --- Płatności Stripe (plany roczne, płatne z góry) -------------------------
# Bez klucza aplikacja działa, a koszyk pokazuje, że płatności są wyłączone.
# Konfiguracja produktów, portalu i webhooka:  pnpm stripe:setup
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true = Stripe Tax liczy VAT z adresu klienta (najpierw włącz Stripe Tax w panelu).
STRIPE_AUTOMATIC_TAX=false

# --- Analityka produktowa (opcjonalnie, ładuje się dopiero po zgodzie na cookies) ---
VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Zgłaszanie błędów serwera do Sentry (region UE). Pusty = błędy tylko w logach.
SENTRY_DSN=
